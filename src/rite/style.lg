(ns rite.style
  (:require [string :as str]))

;; --------------------------------------------------------------------------
;; Styled status output
;;
;; rite prints a short status header before each task and step. Task headers
;; and step lines are decoration: callers write the returned strings to *err*
;; (stdout is reserved for the program's real output). These fns are pure so
;; they stay testable.
;;
;; Color is on only when all three hold:
;;   - RITE_NO_COLOR is blank (the project-specific opt-out),
;;   - NO_COLOR is blank (the de facto standard, https://no-color.org),
;;   - stderr is a terminal (term/tty? on *err*, since every status line goes
;;     there), so piped, redirected, and CI output stays free of escape codes.
;; os/getenv returns "" for an unset var, so a blank value means "not set".
;; --------------------------------------------------------------------------

(def ^:dynamic *stderr-tty?*
  "Zero-arg fn: is *err* a terminal? term/tty? is absent on let-go's js, plan9,
   and wasip1 builds, so any error counts as \"not a tty\". Dynamic so tests
   can bind it instead of depending on a real terminal."
  (fn []
    (try
      (boolean (term/tty? *err*))
      (catch e false))))

(defn color-enabled?
  "True when color output is on. `getenv` maps a var name to its value (pass
   os/getenv, or a fn in tests); `tty?` is a zero-arg fn reporting whether
   stderr is a terminal. A tty? that throws counts as not a terminal."
  [getenv tty?]
  (and (str/blank? (getenv "RITE_NO_COLOR"))
       (str/blank? (getenv "NO_COLOR"))
       (try
         (boolean (tty?))
         (catch e false))))

(def ^:private green-code 35)   ; emerald — built-in command output
(def ^:private purple-code 98)  ; medium violet — project task output

;; Fixed 256-color cube shades chosen for contrast on both light and dark
;; terminals (green = 35 emerald, purple = 98 medium violet), color only — no
;; bold, since these status lines print on every command and a lighter weight
;; reads calmer for everyday use. Cube colors (not the 0-15 theme palette) so the
;; shade stays stable regardless of the user's color scheme.
(defn- colorize [code s]
  (if (color-enabled? os/getenv *stderr-tty?*)
    (str "[38;5;" code "m" s "[0m")
    s))

(defn green
  "Wrap s in green (built-in command color), unless color is disabled."
  [s]
  (colorize green-code s))

(defn purple
  "Wrap s in purple (custom task color), unless color is disabled."
  [s]
  (colorize purple-code s))

(defn header
  "Green `=> <text>` status header for a built-in command."
  [text]
  (green (str "=> " text)))

(defn task-header
  "Purple `=> Running task <name>...` header for a custom project task."
  [name]
  (purple (str "=> Running task " name "...")))

(defn step-line
  "`$ <cmd>` line echoing a task step's command before it runs. The `$` is
   purple to tie the step to its task; the command is plain. Callers add a
   leading blank line to separate each step from the previous step's output."
  [cmd]
  (str (purple "$") " " cmd))
